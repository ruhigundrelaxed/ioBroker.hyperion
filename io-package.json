{
    "common": {
        "name": "hyperion",
        "version": "1.0.2",
        "title": "Hyperion",
        "titleLang": {
            "en": "Hyperion",
            "de": "Hyperion"
        },
        "news": {
            "1.0.0": {
                "en": "Complete rewrite in TypeScript with Hyperion.ng support",
                "de": "Kompletter Rewrite in TypeScript mit Hyperion.ng Unterstützung"
            }
        },
        "license": "MIT",
        "authors": [
            "ruhigundrelaxed <martin@qvadrat.de>"
        ],
        "desc": {
            "en": "Adapter to control Hyperion and Hyperion.ng ambient lighting",
            "de": "Adapter zur Steuerung von Hyperion und Hyperion.ng Ambient Lighting"
        },
        "platform": "Javascript/Node.js",
        "mode": "daemon",
        "compact": true,
        "icon": "hyperion.png",
        "extIcon": "https://raw.githubusercontent.com/ruhigundrelaxed/ioBroker.hyperion/master/admin/hyperion.png",
        "loglevel": "info",
        "type": "lighting",
        "adminUI": {
            "config": "json"
        },
        "connectionType": "local",
        "dataSource": "push",
        "dependencies": [
            {
                "js-controller": ">=5.0.0"
            }
        ],
        "globalDependencies": [],
        "keywords": [
            "hyperion",
            "hyperion.ng",
            "ambilight",
            "ambient lighting"
        ]
    },
    "native": {
        "address": "127.0.0.1",
        "port": 19444,
        "priority": 50,
        "origin": "ioBroker",
        "reconnectInterval": 5,
        "token": "",
        "pollInterval": 30,
        "instance": 0
    },
    "objects": [],
    "instanceObjects": [
        {
            "_id": "info",
            "type": "channel",
            "common": {
                "name": "Information"
            },
            "native": {}
        },
        {
            "_id": "info.connection",
            "type": "state",
            "common": {
                "name": "Connection status",
                "type": "boolean",
                "role": "indicator.connected",
                "read": true,
                "write": false,
                "def": false
            },
            "native": {}
        }
    ]
}
