{
    "common": {
        "name": "hyperion",
        "version": "1.0.3",
        "title": "Hyperion",
        "titleLang": {
            "en": "Hyperion",
            "de": "Hyperion"
        },
        "news": {
            "1.0.3": {
                "en": "Settings from 0.0.x (json_port, prio) are migrated automatically; requires Node.js 20 or newer; tests and CI",
                "de": "Einstellungen aus 0.0.x (json_port, prio) werden automatisch übernommen; benötigt Node.js 20 oder neuer; Tests und CI"
            },
            "1.0.2": {
                "en": "Select the Hyperion.ng instance to control; origin is only sent with color/effect commands",
                "de": "Auswahl der zu steuernden Hyperion.ng-Instanz; origin wird nur noch bei Farb-/Effektbefehlen gesendet"
            },
            "1.0.0": {
                "en": "Complete rewrite in TypeScript with Hyperion.ng support",
                "de": "Kompletter Rewrite in TypeScript mit Hyperion.ng Unterstützung"
            }
        },
        "licenseInformation": {
            "type": "free",
            "license": "MIT"
        },
        "authors": [
            "ruhigundrelaxed <martin@qvadrat.de>"
        ],
        "desc": {
            "en": "Adapter to control Hyperion and Hyperion.ng ambient lighting",
            "de": "Adapter zur Steuerung von Hyperion und Hyperion.ng Ambient Lighting"
        },
        "platform": "Javascript/Node.js",
        "mode": "daemon",
        "tier": 2,
        "compact": true,
        "icon": "hyperion.png",
        "extIcon": "https://raw.githubusercontent.com/ruhigundrelaxed/ioBroker.hyperion/master/admin/hyperion.png",
        "loglevel": "info",
        "type": "lighting",
        "adminUI": {
            "config": "json"
        },
        "connectionType": "local",
        "dataSource": "push",
        "dependencies": [
            {
                "js-controller": ">=5.0.0"
            }
        ],
        "globalDependencies": [],
        "keywords": [
            "hyperion",
            "hyperion.ng",
            "ambilight",
            "ambient lighting"
        ]
    },
    "native": {
        "address": "127.0.0.1",
        "port": 19444,
        "priority": 50,
        "origin": "ioBroker",
        "reconnectInterval": 5,
        "token": "",
        "pollInterval": 30,
        "instance": 0
    },
    "objects": [],
    "instanceObjects": [
        {
            "_id": "info",
            "type": "channel",
            "common": {
                "name": "Information"
            },
            "native": {}
        },
        {
            "_id": "info.connection",
            "type": "state",
            "common": {
                "name": "Connection status",
                "type": "boolean",
                "role": "indicator.connected",
                "read": true,
                "write": false,
                "def": false
            },
            "native": {}
        }
    ]
}
