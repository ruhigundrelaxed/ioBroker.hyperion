{
  "name": "iobroker.hyperion",
  "version": "1.0.3",
  "description": "ioBroker adapter for Hyperion and Hyperion.ng ambient lighting",
  "author": "ruhigundrelaxed <martin@qvadrat.de>",
  "homepage": "https://github.com/ruhigundrelaxed/ioBroker.hyperion/",
  "readme": "https://github.com/ruhigundrelaxed/ioBroker.hyperion/blob/master/README.md",
  "keywords": [
    "ioBroker",
    "hyperion",
    "hyperion.ng",
    "ambilight",
    "ambient lighting"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/ruhigundrelaxed/ioBroker.hyperion.git"
  },
  "dependencies": {
    "@iobroker/adapter-core": "^3.0.0"
  },
  "devDependencies": {
    "@iobroker/testing": "^5.3.0",
    "@types/chai": "^4.3.20",
    "@types/mocha": "^10.0.10",
    "@types/node": "^20.0.0",
    "chai": "^4.5.0",
    "mocha": "^11.8.0",
    "rimraf": "^5.0.10",
    "ts-node": "^10.9.2",
    "typescript": "~5.3.0"
  },
  "bugs": {
    "url": "https://github.com/ruhigundrelaxed/ioBroker.hyperion/issues"
  },
  "main": "build/main.js",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "prebuild": "rimraf build",
    "build": "tsc -p tsconfig.build.json",
    "check": "tsc --noEmit -p tsconfig.json",
    "test:ts": "mocha --config test/mocharc.custom.json",
    "test:package": "mocha test/package --exit",
    "test:integration": "mocha test/integration --exit",
    "test": "npm run test:ts && npm run test:package",
    "prepublishOnly": "npm run build"
  },
  "files": [
    "build/",
    "admin/",
    "io-package.json",
    "LICENSE",
    "README.md"
  ]
}
